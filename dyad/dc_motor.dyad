"""
The bare `DCPlanarMotor` on a fixed mount, for checking the drive on its own.

The motor's `frame_a` is bolted to the world and `frame_b` carries a wheel
inertia, so this is the bench: wheels free, nothing balancing. `duty` is a
constant, and the outputs are the winding current and the shaft speed. The
checks it answers:

- a step of duty rises in current with the electrical time constant `Lm/Rm`,
  about 6 ms
- the speed settles at `Vbus/Kt * duty` less the friction, so at the placeholder
  Vbus a duty of 0.6 gives about 24.9 * 0.6 = 14.9 rad/s
- the speed rises with the mechanical time constant, about 47.5 ms
"""
component DCMotorBench
  world = MultibodyComponents.PlanarMechanics.World(g = 9.82, nominal_length = 0.1) {^world}
  mount = MultibodyComponents.PlanarMechanics.Fixed() {^mount}
  motor = DCPlanarMotor(n_motors = n_motors, Vbus = Vbus, R = Rm, L = Lm, Kt = Kt, d = d, tau_c = tau_c, tau_s = tau_s, w_s = w_s) {^motor}
  wheelinertia = MultibodyComponents.PlanarMechanics.Body(I = Iw, radius = 0.01, m = 0.04, phi(initial = 0.0), w(initial = 0.0)) {^wheelinertia}
  command = BlockComponents.Sources.Step(height = duty, start_time = 0.05, offset = 0.0) {^command}
  "Duty step height"
  parameter duty::Real = 0.6
  parameter Vbus::Real = 7.68
  parameter Rm::Real = 3.3864171
  parameter Lm::Real = 0.0185392
  parameter Kt::Real = 0.2877012
  parameter d::Real = 7.1601e-4
  parameter tau_c::Real = 0.0183125
  parameter tau_s::Real = 0.0447701
  parameter w_s::Real = 0.1
  "One motor only on the bench, so n_motors = 1 and Iw is one wheel and rotor."
  structural parameter n_motors::Real = 1
  parameter Iw::Inertia = 1.3110e-3
relations
  connect(mount.frame_b, motor.frame_a) {^id1}
  connect(motor.frame_b, wheelinertia.frame_a) {^id2}
  connect(command.y, motor.duty) {^id3}
metadata {
  "Dyad": {"tests": {"case1": {"stop": 0.5}}},
  "_links": {
    "world": {
      "Dyad": {"placement": {"diagram": {"x1": 40, "y1": 40, "x2": 140, "y2": 140}}}
    },
    "mount": {
      "Dyad": {"placement": {"diagram": {"x1": 200, "y1": 450, "x2": 300, "y2": 550}}}
    },
    "motor": {
      "Dyad": {"placement": {"diagram": {"x1": 420, "y1": 450, "x2": 520, "y2": 550}}}
    },
    "wheelinertia": {
      "Dyad": {"placement": {"diagram": {"x1": 660, "y1": 450, "x2": 760, "y2": 550}}}
    },
    "command": {
      "Dyad": {"placement": {"diagram": {"x1": 240, "y1": 200, "x2": 340, "y2": 300}}}
    },
    "id1": {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}], "path": {}}},
    "id2": {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}], "path": {}}},
    "id3": {
      "Dyad": {
        "edges": [{"S": 1, "M": [{"x": 380, "y": 250}, {"x": 380, "y": 500}], "E": 2}],
        "path": {}
      }
    }
  }
}
end

"Open-loop bench of the DC drive: a duty step with the wheel free."
analysis DCMotorBenchTransient
  extends TransientAnalysis(stop = 0.5, abstol = 1e-9, reltol = 1e-9)
  model = DCMotorBench()
relations
end
